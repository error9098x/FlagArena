NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://flagarena:replace_me@127.0.0.1:5432/flagarena
JWT_SECRET=replace_with_at_least_32_random_characters
# Defaults to Resend when a key is set; otherwise local files in development.
# MAIL_MODE=file
MAIL_DIR=../var/mail
UPLOAD_DIR=../var/uploads
RESEND_API_KEY=
RESEND_FROM_EMAIL=FlagArena <verify@example.com>
TRUST_PROXY=0
# Enables explicit demo seeding and suppresses delivery to reserved .test inboxes.
DEMO_MODE=0
